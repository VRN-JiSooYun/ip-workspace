generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  team          String?
  fullname      String?
  role          String         @default("USER")
  status        String         @default("ACTIVE")
  banned        Boolean        @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  notificationRecipient NotificationRecipient? @relation("NotificationRecipientLinkedUser")
  notificationRecipientImportBatches NotificationRecipientImportBatch[]
  notificationRecipientImportRuns NotificationRecipientImportRun[]
  auditActions  AuthAuditLog[] @relation("AuditActor")
  auditTargets  AuthAuditLog[] @relation("AuditTarget")
  patentAuditActions PatentAuditLog[] @relation("PatentAuditActor")
  organizationMembers Member[]
  organizationInvitations Invitation[] @relation("InvitationInviter")
  teamMembers    TeamMember[]
  groupwareTeamAssignment GroupwareTeamAssignment?
  updatedTeamModuleAccess TeamModuleAccess[] @relation("TeamModuleAccessUpdater")
  calendarEvents CalendarEvent[] @relation("CalendarEventOwner")

  @@index([role, status])
  @@index([team])
  @@map("user")
}

enum WorkspaceModule {
  PATENT_ANALYSIS
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  createdAt   DateTime     @default(now())
  members     Member[]
  invitations Invitation[]
  teams       Team[]
  teamAliases TeamAlias[]

  @@map("organization")
}

model Member {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  role           String?
  teamId         String?      @db.Uuid
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  organizationId String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  aliases        TeamAlias[]
  moduleAccess   TeamModuleAccess[]
  groupwareAssignments GroupwareTeamAssignment[]
  invitations    Invitation[]
  calendarEvents CalendarEvent[]

  @@index([organizationId])
  @@map("team")
}

/**
 * 일정의 공개 범위.
 *   PRIVATE — 만든 사람만 본다
 *   TEAM    — 같은 팀(teamId) 사람들이 본다. 고치고 지우는 것은 여전히 만든 사람만.
 */
enum CalendarEventVisibility {
  PRIVATE
  TEAM
}

/**
 * 대시보드 일정 위젯이 쓰는 사용자 일정.
 *
 * 특허 라이프사이클 날짜(patent.*)나 PatentTodo와는 다른 종류다. 저쪽은 특허에 딸린
 * 사실이고 이쪽은 사람이 직접 적는 약속이라, 특허와 연결되지 않아도 존재할 수 있어야 한다.
 *
 * 날짜는 시각이 없는 `date`다. 달력이 다루는 것은 "며칠"이지 "몇 시 몇 분"이 아니라서,
 * timestamp로 두면 시간대에 따라 하루가 밀려 보인다. 시각은 종일이 아닌 일정에만 있고
 * `HH:mm` 문자열로 따로 담는다(그날의 벽시계 시각이지 절대 시각이 아니다).
 */
model CalendarEvent {
  id         String                  @id @default(uuid()) @db.Uuid
  ownerId    String                  @map("owner_id") @db.Uuid
  /// visibility가 TEAM일 때만 채워진다.
  teamId     String?                 @map("team_id") @db.Uuid
  visibility CalendarEventVisibility @default(PRIVATE)
  title      String
  startDate  DateTime                @map("start_date") @db.Date
  /// 종료일은 그날을 **포함**한다(사용자가 달력에서 보는 것과 같은 뜻).
  endDate    DateTime                @map("end_date") @db.Date
  allDay     Boolean                 @default(true) @map("all_day")
  /// `HH:mm`. 종일이면 둘 다 NULL이다.
  startTime  String?                 @map("start_time") @db.VarChar(5)
  endTime    String?                 @map("end_time") @db.VarChar(5)
  /// 화면의 색 표식(purple·orange·yellow·teal·blue·red).
  color      String                  @default("purple") @db.VarChar(20)
  memo       String?
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  owner      User                    @relation("CalendarEventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  team       Team?                   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // 목록은 늘 "기간이 겹치는 것"을 묻는다. 소유자별·팀별로 각각 그 조건을 탄다.
  @@index([ownerId, startDate, endDate])
  @@index([teamId, startDate, endDate])
  @@map("calendar_event")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_member")
}

model TeamAlias {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  teamId          String       @db.Uuid
  normalizedAlias String
  displayAlias    String
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([organizationId, normalizedAlias])
  @@index([teamId])
  @@map("team_alias")
}

model GroupwareTeamAssignment {
  userId      String   @id @db.Uuid
  teamId      String   @db.Uuid
  rawTeamName String
  syncedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("groupware_team_assignment")
}

model TeamModuleAccess {
  id          String          @id @default(uuid()) @db.Uuid
  teamId      String          @db.Uuid
  module      WorkspaceModule
  canRead     Boolean         @default(false)
  canWrite    Boolean         @default(false)
  canManage   Boolean         @default(false)
  updatedById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  updatedBy   User?           @relation("TeamModuleAccessUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([teamId, module])
  @@index([module, canRead])
  @@map("team_module_access")
}

enum NotificationRecipientSource {
  GROUPWARE_IMPORT
  WORKSPACE_USER
}

enum NotificationRecipientStatus {
  ACTIVE
  INACTIVE
}

enum NotificationRecipientImportMode {
  DRY_RUN
  APPLY
}

enum NotificationRecipientImportStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum NotificationRecipientImportBatchStatus {
  UPLOADING
  READY
  INVALID
  ARCHIVED
}

enum NotificationRecipientImportIssueSeverity {
  WARNING
  ERROR
}

model NotificationRecipient {
  id                String                      @id @default(uuid()) @db.Uuid
  memberId          Int?                        @unique
  name              String
  email             String
  normalizedEmail   String                      @unique
  linkedUserId      String?                     @unique @db.Uuid
  source            NotificationRecipientSource
  status            NotificationRecipientStatus @default(ACTIVE)
  mailEnabled       Boolean                     @default(true)
  sourceChecksum    String?
  lastSyncedAt      DateTime                    @default(now())
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  linkedUser        User?                       @relation("NotificationRecipientLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@index([status, mailEnabled, name])
  @@index([lastSyncedAt])
  @@map("notification_recipient")
}

model NotificationRecipientImportRun {
  id                String                            @id @default(uuid()) @db.Uuid
  batchId           String?                           @db.Uuid
  mode              NotificationRecipientImportMode
  status            NotificationRecipientImportStatus @default(RUNNING)
  profileVersion    String
  sourceChecksum    String
  sourceCount       Int                               @default(0)
  insertedCount     Int                               @default(0)
  updatedCount      Int                               @default(0)
  unchangedCount    Int                               @default(0)
  skippedCount      Int                               @default(0)
  conflictCount     Int                               @default(0)
  errorCount        Int                               @default(0)
  startedByUserId   String                            @db.Uuid
  startedAt         DateTime                          @default(now())
  finishedAt        DateTime?
  batch             NotificationRecipientImportBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  startedBy         User                              @relation(fields: [startedByUserId], references: [id], onDelete: Restrict)
  issues            NotificationRecipientImportIssue[]

  @@unique([sourceChecksum, profileVersion, mode])
  @@index([batchId, startedAt])
  @@index([status, startedAt])
  @@index([startedByUserId, startedAt])
  @@map("notification_recipient_import_run")
}

model NotificationRecipientImportBatch {
  id                 String                                 @id @default(uuid()) @db.Uuid
  batchKey           String                                 @unique
  status             NotificationRecipientImportBatchStatus @default(UPLOADING)
  sourceChecksum     String?                                @unique
  originalFilename   String
  mimeType           String?
  byteSize           BigInt                                 @default(0)
  uploadedByUserId   String                                 @db.Uuid
  createdAt          DateTime                               @default(now())
  updatedAt          DateTime                               @updatedAt
  readyAt            DateTime?
  archivedAt         DateTime?
  uploadedBy         User                                   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  runs               NotificationRecipientImportRun[]

  @@index([status, createdAt])
  @@index([uploadedByUserId, createdAt])
  @@map("notification_recipient_import_batch")
}

model NotificationRecipientImportIssue {
  id          String                                   @id @default(uuid()) @db.Uuid
  runId       String                                   @db.Uuid
  rowNumber   Int?
  severity    NotificationRecipientImportIssueSeverity
  errorCode   String
  message     String                                   @db.Text
  memberId    Int?
  createdAt   DateTime                                 @default(now())
  run         NotificationRecipientImportRun           @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, severity, rowNumber])
  @@index([errorCode])
  @@map("notification_recipient_import_issue")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String?
  activeOrganizationId String? @db.Uuid
  activeTeamId String? @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  tokenValidatedAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@unique([userId, providerId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model AuthAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  targetUserId String?  @db.Uuid
  eventType    String
  result       String
  errorCode    String?
  requestId    String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([eventType, createdAt])
  @@index([requestId])
  @@index([createdAt])
  @@map("auth_audit_log")
}

// ---------------------------------------------------------------------------
// 특허 도메인
//
// 외부 특허 데이터를 적재하는 테이블 묶음이라 ERD 원본을 그대로 따른다.
// - PK/FK는 uuid가 아닌 int (외부 시스템의 정수 식별자를 그대로 쓴다)
// - column명은 snake_case (@map). 기존 model들은 camelCase column을 쓰므로
//   이 묶음만 규칙이 다르다.
// ---------------------------------------------------------------------------

model Country {
  id      Int      @id @default(autoincrement())
  country String   @unique
  patents Patent[]

  @@map("country")
}

model Attorney {
  attorneyNumber Int      @id @map("attorney_number")
  attorneyName   String?  @map("attorney_name")
  patents        Patent[]

  @@map("attorney")
}

/// 파이프라인에 그려지는 진행 단계의 대분류. 상세 단계 14개를 한 줄에 늘어놓을 수
/// 없어 표시용 상위 묶음을 따로 둔다.
model PatentStageGroup {
  code    String        @id
  label   String
  ordinal Int
  stages  PatentStage[]

  @@map("patent_stage_group")
}

/// 진행 현황(진행 단계) 코드. 정의와 매핑 근거는 docs/patent_stage_definitions.md.
model PatentStage {
  code        String  @id
  label       String
  description String?
  ordinal     Int
  groupCode   String  @map("group_code")
  /// 이 단계가 의미를 갖는 국가/제도. country.country 코드를 콤마로 나열하며
  /// NULL은 공통이다.
  scope       String?
  active      Boolean @default(true)

  group         PatentStageGroup @relation(fields: [groupCode], references: [code], onUpdate: Cascade)
  legalStatuses LegalStatus[]

  @@index([groupCode])
  @@map("patent_stage")
}

model LegalStatus {
  id     Int    @id @default(autoincrement())
  status String
  /// 운영 시트의 "현재 Status"를 진행 단계에 연결한다. 값이 자유 서술이라 매핑은
  /// 사람이 채우고, 아직 연결하지 않은 코드는 NULL로 남는다.
  stageCode String? @map("stage_code")

  stage   PatentStage? @relation(fields: [stageCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  patents Patent[]

  @@index([stageCode])
  @@map("legal_status")
}

model ExamStatus {
  id      Int      @id @default(autoincrement())
  status  String
  patents Patent[]

  @@map("exam_status")
}

model PatentTarget {
  id      Int      @id @default(autoincrement())
  target  String   @unique
  patents Patent[]

  @@map("patent_target")
}

model Patent {
  id                      Int          @id @default(autoincrement())
  countryId               Int          @map("country")

  /// IP팀이 자체 운영하는 내부관리번호. 원문이 정본이고 아래 ref_* 는 파싱 결과다.
  /// 규칙(A25W001, F25W001US ...)에 맞지 않아도 저장은 허용하고, 이때 ref_* 는 비워 둔다.
  internalRef             String?      @unique @map("internal_ref")
  refOrigin               String?      @map("ref_origin")
  refYear                 Int?         @map("ref_year")
  refType                 String?      @map("ref_type")
  refSerial               Int?         @map("ref_serial")
  refCountry              String?      @map("ref_country")

  koreanTitle             String?      @map("korean_title")
  englishTitle            String?      @map("english_title")
  applicationNumber       String       @unique @map("application_number")
  applicationDate         DateTime?    @map("application_date")
  applicant               String?
  attorneyNumber          Int?         @map("attorney_number")
  registrationNumber      String?      @map("registration_number")
  registrationDate        String?      @map("registration_date")
  publicationNumber       String?      @map("publication_number")
  publicationDate         DateTime?    @map("publication_date")
  intApplicationNumber    String?      @map("int_application_number")
  intApplicationDate      DateTime?    @map("int_application_date")
  intPublicationNumber    String?      @map("int_publication_number")
  intPublicationDate      DateTime?    @map("int_publication_date")
  parentApplicationNumber String?      @map("parent_application_number")
  legalStatusId           Int?         @map("legal_status")
  examStatusId            Int?         @map("exam_status")
  exam                    Boolean?
  examDate                DateTime?    @map("exam_date")

  /// Target은 patent_target의 코드명을 참조한다. 나머지 항목은 코드 테이블로
  /// 정규화하지 않고 IP팀 운영 시트에 적힌 문장을 보존한다.
  target                  String?
  inventors               String?
  /// **더 이상 쓰지 않는다.** 20260826120000 마이그레이션이 이 값을 note('설명')로 옮겼고,
  /// 코드 어디에서도 읽거나 쓰지 않는다. 합친 결과를 원본과 대조할 수 있게 컬럼만 남겨 둔
  /// 것이며, 확인이 끝나면 DROP한다. 새 값을 여기 넣으면 화면에 나타나지 않는다.
  statusNote              String?      @map("status_note")
  todoDueDate             DateTime?    @map("todo_due_date")
  /// 분할/계속 등 원출원과의 관계. 상대 출원은 parent_application_number에 적는다.
  relationType            String?      @map("relation_type")
  licenseAgreement        String?      @map("license_agreement")
  rightsChange            String?      @map("rights_change")
  /// 지분약정(지분율 변경) 기존 출원인.
  shareAgreement          String?      @map("share_agreement")
  expectedExpiryDate      DateTime?    @map("expected_expiry_date")
  /// 상세 모달의 '설명'. 화면의 WYSIWYG가 만든 HTML 조각이 들어 있다(옛 행과 CSV로 들어온
  /// 값은 태그 없는 평문일 수 있어, 그리는 쪽이 둘 다 받아 준다). 옛 status_note도 여기로
  /// 합쳐졌다 — 자유 서술은 이 컬럼 하나다.
  note                    String?

  /// 이 행이 처음 만들어진 시각. 마이그레이션 이전 행은 마이그레이션 시점이 들어가 있다
  /// (실제 등록 시점이 아니다 — 그 값은 어디에도 없었다).
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  country     Country      @relation(fields: [countryId], references: [id])
  attorney    Attorney?    @relation(fields: [attorneyNumber], references: [attorneyNumber], onDelete: SetNull)
  legalStatus LegalStatus? @relation(fields: [legalStatusId], references: [id], onDelete: SetNull)
  examStatus  ExamStatus?  @relation(fields: [examStatusId], references: [id], onDelete: SetNull)
  targetCode  PatentTarget? @relation(fields: [target], references: [target], onDelete: SetNull, onUpdate: Cascade)
  patentIpcs  PatentIpc[]
  admins      PatentAdmin[]
  todos       PatentTodo[]
  auditLogs   PatentAuditLog[]

  @@index([countryId])
  @@index([attorneyNumber])
  @@index([legalStatusId])
  @@index([examStatusId])
  @@index([target])
  @@index([applicationDate])
  @@index([publicationDate])
  // 대시보드 기한 보드/KPI가 만료 임박 건을 범위로 조회한다.
  @@index([expectedExpiryDate])
  // 구성요소별 조회와 다음 일련번호 채번(2단계)을 위한 index.
  @@index([refOrigin, refYear, refType, refSerial])
  @@map("patent")
}

/// 관리 특허의 변경 이력.
///
/// `auth_audit_log`와 나란한 개념이지만 별도 테이블이다. 그쪽은 사용자를 축으로 색인돼
/// 있어서 "이 특허의 이력"을 물으면 metadata JSON을 훑어야 한다 — 화면의 활동 피드가
/// 쓸 수 없는 접근이다.
model PatentAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// 특허를 지워도 이력은 남긴다(SetNull). "지웠다"는 기록까지 함께 사라지면 안 된다.
  /// 그래서 nullable이고, 어느 건이었는지는 metadata의 출원번호로 읽는다.
  patentId    Int?     @map("patent_id")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// PATENT_CREATED | PATENT_FIELD_CHANGED | PATENT_IMPORTED | PATENT_DELETED
  eventType   String   @map("event_type")
  /// 바뀐 컬럼 이름. PATENT_FIELD_CHANGED에만 있다.
  field       String?
  /// 코드 id가 아니라 사람이 읽는 값으로 굳혀 둔다. `1 → 2`는 피드에서 뜻이 없고,
  /// 코드 표의 이름이 나중에 바뀌면 과거 이력의 뜻까지 흔들린다.
  beforeValue String?  @map("before_value")
  afterValue  String?  @map("after_value")
  /// 한 요청에서 나온 행들을 묶는다. 화면이 한 덩이로 그린다.
  requestId   String?  @map("request_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  patent Patent? @relation(fields: [patentId], references: [id], onDelete: SetNull)
  actor  User?   @relation("PatentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  /// 활동 피드는 늘 "이 특허의 최신순"을 묻는다.
  @@index([patentId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("patent_audit_log")
}

model PatentTodo {
  id          Int       @id @default(autoincrement())
  patentId    Int       @map("patent_id")
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  /// 기존 patent.todo_due_date/CSV 값을 멱등하게 동기화하기 위한 내부 key.
  /// 사용자가 UI에서 만드는 To-do는 NULL이다.
  sourceKey   String?   @unique @map("source_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  patent      Patent    @relation(fields: [patentId], references: [id], onDelete: Cascade)

  @@index([patentId])
  @@index([completed, dueDate])
  @@map("patent_todo")
}

model Ipc {
  id         Int         @id @default(autoincrement())
  ipcCode    String      @unique @map("ipc_code")
  section    String?
  classCode  String?     @map("class_code")
  subclass   String?
  mainGroup  String?     @map("main_group")
  subgroup   String?
  patentIpcs PatentIpc[]

  @@map("ipc")
}

model PatentIpc {
  id       Int    @id @default(autoincrement())
  patentId Int    @map("patent_id")
  ipcId    Int    @map("ipc_id")
  ordinal  Int
  patent   Patent @relation(fields: [patentId], references: [id], onDelete: Cascade)
  ipc      Ipc    @relation(fields: [ipcId], references: [id], onDelete: Cascade)

  @@unique([patentId, ipcId])
  @@index([patentId])
  @@index([ipcId])
  @@map("patent_ipc")
}

/// ERD의 `admin` 테이블. 사용자 관리(AdminModule)와 구분하려고 model명만 다르게 둔다.
model PatentAdmin {
  id            Int            @id @default(autoincrement())
  patentId      Int            @map("patent_id")
  actionDate    DateTime?      @map("action_date")
  action        String?
  actionNumber  String?        @map("action_number")
  patent        Patent         @relation(fields: [patentId], references: [id], onDelete: Cascade)
  officeActions OfficeAction[]

  @@index([patentId])
  @@index([actionDate])
  @@map("admin")
}

model OfficeAction {
  id           Int                    @id @default(autoincrement())
  adminId      Int                    @map("admin_id")
  content      String?
  documentPath String?                @map("document_path")
  admin        PatentAdmin            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  responses    OfficeActionResponse[]
  oaExaminers  OaExaminer[]
  rejections   Rejection[]

  @@index([adminId])
  @@map("office_action")
}

/// ERD의 `response` 테이블. TypeScript의 express/DOM `Response`와 겹치지 않도록 model명만 다르게 둔다.
model OfficeActionResponse {
  id           Int          @id @default(autoincrement())
  oaId         Int          @map("oa_id")
  type         Int?
  content      String?
  documentPath String?      @map("document_path")
  officeAction OfficeAction @relation(fields: [oaId], references: [id], onDelete: Cascade)

  @@index([oaId])
  @@map("response")
}

model Examiner {
  id          Int          @id @default(autoincrement())
  office      String?
  bureau      String?
  department  String?
  name        String
  oaExaminers OaExaminer[]

  @@map("examiner")
}

model OaExaminer {
  id           Int          @id @default(autoincrement())
  oaId         Int          @map("oa_id")
  examinerId   Int          @map("examiner_id")
  officeAction OfficeAction @relation(fields: [oaId], references: [id], onDelete: Cascade)
  examiner     Examiner     @relation(fields: [examinerId], references: [id], onDelete: Cascade)

  @@unique([oaId, examinerId])
  @@index([oaId])
  @@index([examinerId])
  @@map("oa_examiner")
}

model LegalStatute {
  id           Int         @id @default(autoincrement())
  lawType      Int?        @map("law_type")
  article      Int?
  paragraph    Int?
  subParagraph Int?        @map("sub_paragraph")
  rejections   Rejection[]

  @@map("legal_statutes")
}

model Rejection {
  id           Int           @id @default(autoincrement())
  oaId         Int           @map("oa_id")
  claim        String?
  statuteId    Int?          @map("statute_id")
  officeAction OfficeAction  @relation(fields: [oaId], references: [id], onDelete: Cascade)
  statute      LegalStatute? @relation(fields: [statuteId], references: [id], onDelete: SetNull)

  @@index([oaId])
  @@index([statuteId])
  @@map("rejection")
}
