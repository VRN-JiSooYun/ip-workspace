generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  team          String?
  fullname      String?
  role          String         @default("USER")
  status        String         @default("ACTIVE")
  banned        Boolean        @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  notificationRecipient NotificationRecipient? @relation("NotificationRecipientLinkedUser")
  notificationRecipientImportBatches NotificationRecipientImportBatch[]
  notificationRecipientImportRuns NotificationRecipientImportRun[]
  auditActions  AuthAuditLog[] @relation("AuditActor")
  auditTargets  AuthAuditLog[] @relation("AuditTarget")
  organizationMembers Member[]
  organizationInvitations Invitation[] @relation("InvitationInviter")
  teamMembers    TeamMember[]
  groupwareTeamAssignment GroupwareTeamAssignment?
  updatedTeamModuleAccess TeamModuleAccess[] @relation("TeamModuleAccessUpdater")

  @@index([role, status])
  @@index([team])
  @@map("user")
}

enum WorkspaceModule {
  PATENT_ANALYSIS
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  createdAt   DateTime     @default(now())
  members     Member[]
  invitations Invitation[]
  teams       Team[]
  teamAliases TeamAlias[]

  @@map("organization")
}

model Member {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  role           String?
  teamId         String?      @db.Uuid
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  organizationId String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  aliases        TeamAlias[]
  moduleAccess   TeamModuleAccess[]
  groupwareAssignments GroupwareTeamAssignment[]
  invitations    Invitation[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_member")
}

model TeamAlias {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  teamId          String       @db.Uuid
  normalizedAlias String
  displayAlias    String
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([organizationId, normalizedAlias])
  @@index([teamId])
  @@map("team_alias")
}

model GroupwareTeamAssignment {
  userId      String   @id @db.Uuid
  teamId      String   @db.Uuid
  rawTeamName String
  syncedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("groupware_team_assignment")
}

model TeamModuleAccess {
  id          String          @id @default(uuid()) @db.Uuid
  teamId      String          @db.Uuid
  module      WorkspaceModule
  canRead     Boolean         @default(false)
  canWrite    Boolean         @default(false)
  canManage   Boolean         @default(false)
  updatedById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  updatedBy   User?           @relation("TeamModuleAccessUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([teamId, module])
  @@index([module, canRead])
  @@map("team_module_access")
}

enum NotificationRecipientSource {
  GROUPWARE_IMPORT
  WORKSPACE_USER
}

enum NotificationRecipientStatus {
  ACTIVE
  INACTIVE
}

enum NotificationRecipientImportMode {
  DRY_RUN
  APPLY
}

enum NotificationRecipientImportStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum NotificationRecipientImportBatchStatus {
  UPLOADING
  READY
  INVALID
  ARCHIVED
}

enum NotificationRecipientImportIssueSeverity {
  WARNING
  ERROR
}

model NotificationRecipient {
  id                String                      @id @default(uuid()) @db.Uuid
  memberId          Int?                        @unique
  name              String
  email             String
  normalizedEmail   String                      @unique
  linkedUserId      String?                     @unique @db.Uuid
  source            NotificationRecipientSource
  status            NotificationRecipientStatus @default(ACTIVE)
  mailEnabled       Boolean                     @default(true)
  sourceChecksum    String?
  lastSyncedAt      DateTime                    @default(now())
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  linkedUser        User?                       @relation("NotificationRecipientLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@index([status, mailEnabled, name])
  @@index([lastSyncedAt])
  @@map("notification_recipient")
}

model NotificationRecipientImportRun {
  id                String                            @id @default(uuid()) @db.Uuid
  batchId           String?                           @db.Uuid
  mode              NotificationRecipientImportMode
  status            NotificationRecipientImportStatus @default(RUNNING)
  profileVersion    String
  sourceChecksum    String
  sourceCount       Int                               @default(0)
  insertedCount     Int                               @default(0)
  updatedCount      Int                               @default(0)
  unchangedCount    Int                               @default(0)
  skippedCount      Int                               @default(0)
  conflictCount     Int                               @default(0)
  errorCount        Int                               @default(0)
  startedByUserId   String                            @db.Uuid
  startedAt         DateTime                          @default(now())
  finishedAt        DateTime?
  batch             NotificationRecipientImportBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  startedBy         User                              @relation(fields: [startedByUserId], references: [id], onDelete: Restrict)
  issues            NotificationRecipientImportIssue[]

  @@unique([sourceChecksum, profileVersion, mode])
  @@index([batchId, startedAt])
  @@index([status, startedAt])
  @@index([startedByUserId, startedAt])
  @@map("notification_recipient_import_run")
}

model NotificationRecipientImportBatch {
  id                 String                                 @id @default(uuid()) @db.Uuid
  batchKey           String                                 @unique
  status             NotificationRecipientImportBatchStatus @default(UPLOADING)
  sourceChecksum     String?                                @unique
  originalFilename   String
  mimeType           String?
  byteSize           BigInt                                 @default(0)
  uploadedByUserId   String                                 @db.Uuid
  createdAt          DateTime                               @default(now())
  updatedAt          DateTime                               @updatedAt
  readyAt            DateTime?
  archivedAt         DateTime?
  uploadedBy         User                                   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  runs               NotificationRecipientImportRun[]

  @@index([status, createdAt])
  @@index([uploadedByUserId, createdAt])
  @@map("notification_recipient_import_batch")
}

model NotificationRecipientImportIssue {
  id          String                                   @id @default(uuid()) @db.Uuid
  runId       String                                   @db.Uuid
  rowNumber   Int?
  severity    NotificationRecipientImportIssueSeverity
  errorCode   String
  message     String                                   @db.Text
  memberId    Int?
  createdAt   DateTime                                 @default(now())
  run         NotificationRecipientImportRun           @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, severity, rowNumber])
  @@index([errorCode])
  @@map("notification_recipient_import_issue")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String?
  activeOrganizationId String? @db.Uuid
  activeTeamId String? @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  tokenValidatedAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@unique([userId, providerId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model AuthAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  targetUserId String?  @db.Uuid
  eventType    String
  result       String
  errorCode    String?
  requestId    String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([eventType, createdAt])
  @@index([requestId])
  @@index([createdAt])
  @@map("auth_audit_log")
}

// ---------------------------------------------------------------------------
// 특허 도메인
//
// 외부 특허 데이터를 적재하는 테이블 묶음이라 ERD 원본을 그대로 따른다.
// - PK/FK는 uuid가 아닌 int (외부 시스템의 정수 식별자를 그대로 쓴다)
// - column명은 snake_case (@map). 기존 model들은 camelCase column을 쓰므로
//   이 묶음만 규칙이 다르다.
// ---------------------------------------------------------------------------

model Country {
  id      Int      @id @default(autoincrement())
  country String   @unique
  patents Patent[]

  @@map("country")
}

model Attorney {
  attorneyNumber Int      @id @map("attorney_number")
  attorneyName   String?  @map("attorney_name")
  patents        Patent[]

  @@map("attorney")
}

model LegalStatus {
  id      Int      @id @default(autoincrement())
  status  String
  patents Patent[]

  @@map("legal_status")
}

model ExamStatus {
  id      Int      @id @default(autoincrement())
  status  String
  patents Patent[]

  @@map("exam_status")
}

model Patent {
  id                      Int          @id @default(autoincrement())
  countryId               Int          @map("country")

  /// IP팀이 자체 운영하는 내부관리번호. 원문이 정본이고 아래 ref_* 는 파싱 결과다.
  /// 규칙(A25W001, F25W001US ...)에 맞지 않아도 저장은 허용하고, 이때 ref_* 는 비워 둔다.
  internalRef             String?      @unique @map("internal_ref")
  refOrigin               String?      @map("ref_origin")
  refYear                 Int?         @map("ref_year")
  refType                 String?      @map("ref_type")
  refSerial               Int?         @map("ref_serial")
  refCountry              String?      @map("ref_country")

  koreanTitle             String?      @map("korean_title")
  englishTitle            String?      @map("english_title")
  applicationNumber       String       @unique @map("application_number")
  applicationDate         DateTime?    @map("application_date")
  applicant               String?
  attorneyNumber          Int?         @map("attorney_number")
  registrationNumber      String?      @map("registration_number")
  registrationDate        String?      @map("registration_date")
  publicationNumber       String?      @map("publication_number")
  publicationDate         DateTime?    @map("publication_date")
  intApplicationNumber    String?      @map("int_application_number")
  intApplicationDate      DateTime?    @map("int_application_date")
  intPublicationNumber    String?      @map("int_publication_number")
  intPublicationDate      DateTime?    @map("int_publication_date")
  parentApplicationNumber String?      @map("parent_application_number")
  legalStatusId           Int?         @map("legal_status")
  examStatusId            Int?         @map("exam_status")
  exam                    Boolean?
  examDate                DateTime?    @map("exam_date")

  /// IP팀 운영 시트에서 그대로 넘어오는 항목들. 코드 테이블로 정규화하지 않고
  /// 시트에 적힌 문장을 보존한다.
  target                  String?
  inventors               String?
  /// "현재 Status"(legal_status) 옆에 붙는 자유 서술.
  statusNote              String?      @map("status_note")
  todoDueDate             DateTime?    @map("todo_due_date")
  /// 분할/계속 등 원출원과의 관계. 상대 출원은 parent_application_number에 적는다.
  relationType            String?      @map("relation_type")
  licenseAgreement        String?      @map("license_agreement")
  rightsChange            String?      @map("rights_change")
  /// 지분약정(지분율 변경) 기존 출원인.
  shareAgreement          String?      @map("share_agreement")
  expectedExpiryDate      DateTime?    @map("expected_expiry_date")
  note                    String?

  country     Country      @relation(fields: [countryId], references: [id])
  attorney    Attorney?    @relation(fields: [attorneyNumber], references: [attorneyNumber], onDelete: SetNull)
  legalStatus LegalStatus? @relation(fields: [legalStatusId], references: [id], onDelete: SetNull)
  examStatus  ExamStatus?  @relation(fields: [examStatusId], references: [id], onDelete: SetNull)
  patentIpcs  PatentIpc[]
  admins      PatentAdmin[]

  @@index([countryId])
  @@index([attorneyNumber])
  @@index([legalStatusId])
  @@index([examStatusId])
  @@index([applicationDate])
  @@index([publicationDate])
  // 구성요소별 조회와 다음 일련번호 채번(2단계)을 위한 index.
  @@index([refOrigin, refYear, refType, refSerial])
  @@map("patent")
}

model Ipc {
  id         Int         @id @default(autoincrement())
  ipcCode    String      @unique @map("ipc_code")
  section    String?
  classCode  String?     @map("class_code")
  subclass   String?
  mainGroup  String?     @map("main_group")
  subgroup   String?
  patentIpcs PatentIpc[]

  @@map("ipc")
}

model PatentIpc {
  id       Int    @id @default(autoincrement())
  patentId Int    @map("patent_id")
  ipcId    Int    @map("ipc_id")
  ordinal  Int
  patent   Patent @relation(fields: [patentId], references: [id], onDelete: Cascade)
  ipc      Ipc    @relation(fields: [ipcId], references: [id], onDelete: Cascade)

  @@unique([patentId, ipcId])
  @@index([patentId])
  @@index([ipcId])
  @@map("patent_ipc")
}

/// ERD의 `admin` 테이블. 사용자 관리(AdminModule)와 구분하려고 model명만 다르게 둔다.
model PatentAdmin {
  id            Int            @id @default(autoincrement())
  patentId      Int            @map("patent_id")
  actionDate    DateTime?      @map("action_date")
  action        String?
  actionNumber  String?        @map("action_number")
  patent        Patent         @relation(fields: [patentId], references: [id], onDelete: Cascade)
  officeActions OfficeAction[]

  @@index([patentId])
  @@index([actionDate])
  @@map("admin")
}

model OfficeAction {
  id           Int                    @id @default(autoincrement())
  adminId      Int                    @map("admin_id")
  content      String?
  documentPath String?                @map("document_path")
  admin        PatentAdmin            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  responses    OfficeActionResponse[]
  oaExaminers  OaExaminer[]
  rejections   Rejection[]

  @@index([adminId])
  @@map("office_action")
}

/// ERD의 `response` 테이블. TypeScript의 express/DOM `Response`와 겹치지 않도록 model명만 다르게 둔다.
model OfficeActionResponse {
  id           Int          @id @default(autoincrement())
  oaId         Int          @map("oa_id")
  type         Int?
  content      String?
  documentPath String?      @map("document_path")
  officeAction OfficeAction @relation(fields: [oaId], references: [id], onDelete: Cascade)

  @@index([oaId])
  @@map("response")
}

model Examiner {
  id          Int          @id @default(autoincrement())
  office      String?
  bureau      String?
  department  String?
  name        String
  oaExaminers OaExaminer[]

  @@map("examiner")
}

model OaExaminer {
  id           Int          @id @default(autoincrement())
  oaId         Int          @map("oa_id")
  examinerId   Int          @map("examiner_id")
  officeAction OfficeAction @relation(fields: [oaId], references: [id], onDelete: Cascade)
  examiner     Examiner     @relation(fields: [examinerId], references: [id], onDelete: Cascade)

  @@unique([oaId, examinerId])
  @@index([oaId])
  @@index([examinerId])
  @@map("oa_examiner")
}

model LegalStatute {
  id           Int         @id @default(autoincrement())
  lawType      Int?        @map("law_type")
  article      Int?
  paragraph    Int?
  subParagraph Int?        @map("sub_paragraph")
  rejections   Rejection[]

  @@map("legal_statutes")
}

model Rejection {
  id           Int           @id @default(autoincrement())
  oaId         Int           @map("oa_id")
  claim        String?
  statuteId    Int?          @map("statute_id")
  officeAction OfficeAction  @relation(fields: [oaId], references: [id], onDelete: Cascade)
  statute      LegalStatute? @relation(fields: [statuteId], references: [id], onDelete: SetNull)

  @@index([oaId])
  @@index([statuteId])
  @@map("rejection")
}
