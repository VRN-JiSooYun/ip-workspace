# Build stage
FROM oven/bun:1-alpine AS build
WORKDIR /app

# 종속성 및 설정 파일 설치
COPY package.json bun.lockb* tsconfig*.json ./
RUN bun install

# 소스 복사 및 빌드
COPY . .
RUN bun run build

# Production stage
FROM nginx:stable-alpine
# 빌드된 파일 복사
COPY --from=build /app/dist /usr/share/nginx/html
# PDF.js 렌더링용 wasm을 외부 CDN 대신 dev 서버에서 제공
COPY --from=build /app/node_modules/pdfjs-dist/wasm /usr/share/nginx/html/pdfjs/wasm
# Nginx 템플릿 복사 (런타임에 envsubst로 치환)
COPY nginx.conf /etc/nginx/templates/default.conf.template
# Runtime env 템플릿 및 치환 스크립트
COPY env.template.js /usr/share/nginx/html/env.template.js
COPY docker-entrypoint.d/20-envsubst.sh /docker-entrypoint.d/20-envsubst.sh

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
